pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('PULL STAGE') {
            steps {
                git 'https://github.com/Yusuf-tech196/pipeline786.git'
                echo "PULL SUCCESS"
            }
        }

        stage('BUILD STAGE') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn clean package -DskipTests'
                }
                echo "BUILD SUCCESS"
            }
        }

        stage('TEST STAGE') {
            steps {
                withSonarQubeEnv(credentialsId: 'SonarQube', installationName: 'MySonarQube') {
                    dir('backend') {
                        sh '''mvn sonar:sonar \\
                        -Dsonar.projectKey=my-app786 \\
                        -Dsonar.projectName='my-app786' \\
                        -Dsonar.host.url=http://13.62.177.137:9000 \\
                        -Dsonar.token=sqp_4afe0f1e4b0b7cab3adbf75bd2f34e74b31fa609'''
                    }
                }
                echo "TEST SUCCESS"
            }
        }

        stage('DEPLOY STAGE') {
            steps {
                echo "DEPLOY SUCCESS"
            }
        }
    }
}
